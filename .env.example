# Optional runtime knobs for the generated n8n workflow.
# These are read by shell commands inside n8n Execute Command nodes.

CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=medium
CLAUDE_MAX_BUDGET_USD=5
ANTIGRAVITY_BIN=agy

# Optional provider auth secrets, resolved at runtime by the auth strategy.
# sessions.json references these by environment-variable NAME only (never the
# raw value) via the workItemProvider/repoHostProvider auth blocks. See
# docs/provider-architecture.md. Uncomment and set when using github-app auth.
# N8N_AI_GITHUB_APP_ID=123456
# N8N_AI_GITHUB_INSTALLATION_ID=78901234
# N8N_AI_GITHUB_APP_PRIVATE_KEY_PATH=~/.config/n8n-ai-cli-loop/app-key.pem
# Jira (api-token mode):
# N8N_AI_JIRA_EMAIL=bot@acme.example
# N8N_AI_JIRA_API_TOKEN=...
# Gitea (api-token mode) — used by both the gitea-issues work-item provider and
# the gitea repo-host provider; the same token can serve both blocks.
# N8N_AI_GITEA_API_TOKEN=...
